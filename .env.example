# 金融对账单智能解析与问答系统 - 环境变量配置
# 复制此文件为 .env 并填写实际值: cp .env.example .env

# ==========================================
# 千问 Token Plan API (必填)
# ==========================================
# 获取 API Key: https://platform.qianwenai.com/home/api-keys
OPENAI_API_KEY=your_token_plan_key_here

# ==========================================
# 模型服务 (本地 llama.cpp / LM Studio)
# ==========================================
# Qwen3.6-35B-A3B 生成 + 视觉 OCR
LLM_BASE_URL=http://127.0.0.1:8004/v1
# 嵌入模型 (通常与 LLM 同端口)
EMBEDDING_BASE_URL=http://127.0.0.1:8004/v1

# ==========================================
# 本地 Embedding（推荐；配置后无需云端 key）
# ==========================================
# 配置后 embedding 走本地 SentenceTransformer；目录不存在直接报错（fail-closed，不静默降级）
# ARM64/GB10 必须 DEVICE=cpu（CUDA Triton JIT 不可用）
LOCAL_EMBEDDING_MODEL_PATH=~/wzh/models/hf/qwen3-embedding-0.6b
LOCAL_EMBEDDING_DEVICE=cpu


# ==========================================
# 数据库 (PostgreSQL + PGVector)
# ==========================================
DATABASE_URL=postgresql://postgres:postgres@localhost:15432/m1_statements

# ==========================================
# M1 解析配置
# ==========================================
# 是否启用 LLM 兜底字段映射 (1=启用, 0=禁用)
M1_LLM_FALLBACK=1

# ==========================================
# M2 问答配置
# ==========================================
# 生成模型超时 (秒)
M2_LLM_TIMEOUT=60
# 生成最大 token 数
M2_LLM_MAX_TOKENS=512

# ==========================================
# Responses API 代理 (可选, 用于 glm/deepseek)
# ==========================================
PROXY_PORT=8100

# ==========================================
# 安全配置 (生产环境必须)
# ==========================================
JWT_SECRET_KEY=change_me_in_production
DEFAULT_ADMIN_PASSWORD=change_me_in_production

# ==========================================
# 使用说明
# ==========================================
# 1. cp .env.example .env
# 2. 编辑 .env, 填入 OPENAI_API_KEY
# 3. 确保 PGVector 运行: docker compose up -d pgvector
# 4. 确保模型服务运行 (:8004)
# 5. 启动: bash scripts/run.sh

# M2 可选开关（audit 2026-08-10 F15 登记）
# BM25 混合检索: A/B 16 题零增益, 默认关闭; 语料规模扩大后可实验性开启
M2_ENABLE_BM25=false
# schema 写接口(规则配置/建议映射 apply)管理 token: 生产部署必须设置, 未设则接口无保护(仅启动 warning)
# M1_ADMIN_TOKEN=change-me

# --- OpenCode sidecar (A2 灰度 agent 路) ---
# M2_OPENCODE_ROUTE=off            # on 开启 agent 路 (默认 off)
# OPENCODE_ASK_TIMEOUT=18          # agent 路超时秒数, 超时优雅回落直连
# OPENCODE_MAX_SESSIONS=100        # sidecar 会话保留上限
# OPENCODE_SERVE_URL=http://127.0.0.1:4096

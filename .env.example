# 建账规则助手系统 - 环境变量配置示例
# 复制此文件为 .env 并填写实际值

# ==========================================
# 安全配置（生产环境必须配置）
# ==========================================
# JWT 密钥：用于签名认证令牌，生产环境必须设置为强随机字符串
# 生成方式：python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your_jwt_secret_key_here

# 默认管理员密码：首次启动时创建的管理员账户密码
# 生产环境应设置强密码，并在首次登录后修改
DEFAULT_ADMIN_PASSWORD=your_strong_password_here

# CORS 允许的源：多个源用逗号分隔，生产环境应限制为实际域名
# 例如：https://yourdomain.com,https://api.yourdomain.com
CORS_ORIGINS=*

# ==========================================
# SiliconFlow API 配置
# ==========================================
# 获取 API Key: https://cloud.siliconflow.cn/
SILICONFLOW_API_KEY=your_api_key_here
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
# 是否继承系统代理：false=直连（推荐，避免本地代理导致 API 连接失败）
OPENAI_TRUST_ENV=false

# ==========================================
# 数据库配置（PostgreSQL）
# ==========================================
# 注意：需要安装 PGVector 扩展
DB_HOST=localhost
DB_PORT=15432
DB_NAME=vector_db
DB_USER=postgres
DB_PASSWORD=your_password_here
PGDATABASE_URL=postgresql://postgres:your_password_here@localhost:15432/vector_db

# ==========================================
# 对象存储配置（可选）
# ==========================================
# 如果使用本地存储，可以留空
# 如果使用 S3 兼容存储，需要配置相应参数
STORAGE_TYPE=local
STORAGE_PATH=d:/AIRcommend/JinRongAgents/agents_final_tech/assets
BUCKET_ENDPOINT_URL=
BUCKET_NAME=

# ==========================================
# Flask Web 服务配置
# ==========================================
FLASK_APP=src/web/app.py
FLASK_ENV=development
FLASK_DEBUG=false
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# ==========================================
# 其他配置
# ==========================================
# 日志级别: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# 临时文件路径
TEMP_DIR=/tmp

# BM25 缓存目录
BM25_CACHE_DIR=/tmp/bm25_cache

# ==========================================
# 使用说明
# ==========================================
# 1. 复制此文件: cp .env.example .env
# 2. 编辑 .env 文件，填写实际配置
# 3. 确保数据库已创建并安装了 PGVector 扩展
# 4. 启动服务: python src/main.py

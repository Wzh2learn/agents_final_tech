  "schemas": {
    "consume": {
      "$id": "tatqa_wp2_bridge_consume_v2",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "delta_source": {
          "pattern": "^-?(?:[0-9]+(?:\\.[0-9]+)?|\\.[0-9]+)$",
          "type": "number",
          "x-decimal-char-class": "-0123456789."
        },
        "delta_target": {
          "pattern": "^-?(?:[0-9]+(?:\\.[0-9]+)?|\\.[0-9]+)$",
          "type": "number",
          "x-decimal-char-class": "-0123456789."
        },
        "periods": {
          "items": {
            "type": "string"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        },
        "row": {
          "type": "string"
        },
        "unit": {
          "type": "string"
        }
      },
      "required": [
        "row",
        "periods",
        "delta_source",
        "delta_target",
        "unit"
      ],
      "type": "object"
    },
    "plan": {
      "$id": "tatqa_wp2_bridge_plan_v2",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "params": {
          "additionalProperties": false,
          "properties": {
            "expression": {
              "minLength": 1,
              "pattern": "^[0-9+\\-*/(). ]+$",
              "type": "string",
              "x-char-class": "[0-9+\\\\-*/(). ]"
            }
          },
          "required": [
            "expression"
          ],
          "type": "object"
        },
        "tool": {
          "const": "calc",
          "type": "string"
        }
      },
      "required": [
        "tool",
        "params"
      ],
      "type": "object"
    }
  }

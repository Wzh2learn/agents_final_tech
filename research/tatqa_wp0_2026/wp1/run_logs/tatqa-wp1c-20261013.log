y]:\n   505\t    fixture = fixtures[\"fixtures\"][0]\n   506\t    item = fixture_item(fixture)\n   507\t    expected = {\n   508\t        \"correct\": \"correct\",\n   509\t        \"correct_other_form\": \"correct_other_form\",\n   510\t        \"wrong_unit\": \"wrong_unit\",\n   511\t        \"wrong_period\": \"wrong_period\",\n   512\t        \"wrong\": \"wrong\",\n   513\t        \"refused\": \"refused\",\n   514\t        \"unknown\": \"unknown\",\n   515\t        \"unparseable\": \"unknown\",\n   516\t    }\n   517\t    results = []\n   518\t    for case_id, expected_outcome in expected.items():\n   519\t        actual = _score_fixture_item(\n   520\t            fixture,\n   521\t            fixture[\"answers\"][case_id],\n   522\t            \"run_fixtures.py:_check_taxonomy\",\n   523\t        )[\"outcome\"]\n   524\t        _require(\n   525\t            actual == expected_outcome,\n   526\t            f\"taxonomy {case_id}: {actual} != {expected_outcome}\",\n   527\t        )\n   528\t        results.append(\n   529\t            {\n   530\t                \"case_id\": case_id,\n   531\t                \"expected\": expected_outcome,\n   532\t                \"actual\": actual,\n   533\t            }\n   534\t        )\n   535\t    observed_classes = {row[\"actual\"] for row in results}\n   536\t    _require(\n   537\t        observed_classes == set(checker.OUTCOME_CLASSES),\n   538\t        f\"taxonomy coverage mismatch: {observed_classes} != {checker.OUTCOME_CLASSES}\",\n   539\t    )\n   540\t    return {\n   541\t        \"case_count\": len(results),\n   542\t        \"declared_outcome_classes\": sorted(checker.OUTCOME_CLASSES),\n   543\t        \"observed_outcome_classes\": sorted(observed_classes),\n   544\t        \"results\": results,\n   545\t    }\n   546\t\n   547\t\n   548\tdef _check_regression(fixtures: Mapping[str, Any]) -> Mapping[str, Any]:\n   549\t    cases = [\n   550\t        (\"correct\", \"wrong_unit\", \"regressed\"),\n   551\t       
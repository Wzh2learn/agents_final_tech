n   712\t        },\n   713\t        \"failed_checks\": failed,\n   714\t        \"checks\": checks,\n   715\t    }\n   716\t\n   717\t\n   718\tdef _write_prereg(fixtures: Mapping[str, Any], preflight: Mapping[str, Any]) -> None:\n   719\t    pins = {\n   720\t        \"checker\": sha256_file(WORK_DIR / \"checker.py\"),\n   721\t        \"adapter\": sha256_file(WORK_DIR / \"adapter.py\"),\n   722\t        \"fixtures\": sha256_file(FIXTURE_PATH),\n   723\t        \"preflight\": sha256_file(PREFLIGHT_PATH),\n   724\t        \"contract\": sha256_file(WORK_DIR / \"implementation_contract.md\"),\n   725\t    }\n   726\t    _require(preflight[\"status\"] == \"PASS\", \"preflight is not PASS\")\n   727\t    _require(\n   728\t        all(value != \"PENDING_FIXTURE_HASH\" for value in pins.values()),\n   729\t        \"fixture hash pin unresolved\",\n   730\t    )\n   731\t    text = f\"\"\"# TAT-QA WP-2 Preregistration Draft Skeleton\n   732\t\n   733\tStatus: `DRAFT - NOT READY - NO PILOT AUTHORIZATION`\n   734\t\n   735\tTask: `tatqa_wp1_loop_a`\n   736\t\n   737\tThis skeleton freezes no experiment and authorizes no model call. All actor, context, budget, window, and governance fields remain pending until owner/advisor selection and approval.\n   738\t\n   739\t## 1. Scientific scope\n   740\t\n   741\t- Question: whether fixed, related real execution experience changes performance on new-origin two-period table-calculation tasks.\n   742\t- Independent unit: origin.\n   743\t- Arms: B, E, C, S as defined by the frozen evaluation protocol.\n   744\t- Primary outcomes: `correct`, `correct_other_form`, `wrong_unit`, `wrong_period`, `regressed`, `refused`, and `unknown`.\n   745\t- No training, memory write-back, pilot execution, or candidate-item scoring is authorized by WP-1.\n   746\t\n   747\t## 2. Frozen software pins\n   748\t\n   749\t- Checker: `{pins['checker']}`\n   750\t- Adapter: `{pins['adapter']}`\n   751\t- Synthetic fixtures: `{pins['fixtures']}`\n   752\t- Preflight receipt: `{pins['preflight']}`\n   753\t- Implementation contract: `{pins['contract']}`\n   754\t\n   755\t## 3. Actor freeze\n   756\t\n   757\t- Actor revision: `PENDING`\n   758\t- Model identity: `PENDING`\n   759\t- Model settings: `PENDING`\n   760\t- Calculator/tool implementation hash: `PENDING`\n   761\t- Adapter settings: `PENDING`\n   762\t\n   763\t## 4. Experience context\n   764\t\n   765\t- Episode-source contract: `PENDING`\n   766\t- Real E blocks: `PENDING`\n   767\t- Real C blocks: `PENDING`\n   768\t- Origin-disjointness receipt: `PENDING`\n   769\t- Near-duplicate isolation receipt: `PENDING`\n   770\t- E/C token-delta receipt: `PENDING`\n   771\t- S rules: `PENDING`\n   772\t\n   773\t## 5. Evaluation and analysis\n   774\t\n   775\t- Frozen item/split receipt: `PENDING`\n   776\t- Pilot task list: `PENDING`\n   777\t- Repeat count and ordering: `PENDING`\n   778\t- Analysis script hash: `PENDING`\n   779\t- Bootstrap method and seed: `PENDING`\n   780\t- Origin-level difference table: `PENDING`\n   781\t\n   782\t## 6. Budget, window, and governance\n   783\t\n   784\t- Owner authorization: `PENDING`\n   785\t- Advisor authorization: `PENDING`\n   786\t- Budget/window binding: `PENDING`\n   787\t- Start/end UTC: `PENDING`\n   788\t- Model-call budget: `PENDING`\n   789\t- Endpoint-call budget: `PENDING`\n   790\t- Judge-call budget: `0`\n   791\t\n   792\t## 7. Stop rules\n   793\t\n   794\t- Leakage or bridge failure: `STOP_THIS_PANEL`\n   795\t- B ceiling on both repeats: `STOP_THIS_PANEL`\n   796\t- Any unauthorized model, judge, endpoint, database, or service call: stop and report.\n   797\t- Fixture or checker failure: report `SOFTWARE_NOT_QUALIFIED`; never weaken the failing test.\n   798\t\"\"\"\n   799\t    PREREG_PATH.write_text(text, encoding=\"utf-8\", newline=\"\\n\")\n   800\t\n   801\t\n   802\tdef write_outputs(\n   803\t    fixtures: Mapping[str, Any],\n   804\t    obligations: list[dict[str, Any]],\n   805\t    metrics: Mapping[str, Any],\n   806\t) -> None:\n   807\t    preflight = _preflight_checks(fixtures)\n   808\t    preflight[\"run_id\"] = RUN_ID\n   809\t    provenance.write_json_lf(PREFLIGHT_PATH, preflight)\n   810\t    artifact_hashes = {\n   811\t        \"checker\": sha256_file(WORK_DIR / \"checker.py\"),\n   812\t        \"adapter\": sha256_file(WORK_DIR / \"adapter.py\"),\n   813\t        \"provenance\": sha256_file(WORK_DIR / \"provenance.py\"),\n   814\t        \"run_fixtures\": sha256_file(WORK_DIR / \"run_fixtures.py\"),\n   815\t        \"fixtures\": sha256_file(FIXTURE_PATH),\n   816\t        \"contract\": sha256_file(WORK_DIR / \"implementation_contract.md\"),\n   817\t        \"preflight\": sha256_file(PREFLIGHT_PATH),\n   818\t    }\n   819\t    fixture_payload = provenance.attributed_payload(\n   820\t        {\n   821\t            \"schema\": \"tatqa_wp1_fixture_receipt_v1\",\n   822\t            \"run_id\": RUN_ID,\n   823\t            \"task\": \"tatqa_wp1_loop_a\",\n   824\t            \"status\": (\n   825\t                \"PASS\"\n   826\t                if all(row[\"status\"] == \"PASS\" for row in obligations)\n   827\t                and all(\n   828\t                    row[\"status\"] == \"PASS\"\n   829\t                    for row in metrics[\"additional_checks\"]\n   830\t                )\n   831\t                and metrics[\"metric_pipeline\"][\"status\"] == \"PASS\"\n   832\t                else \"FAIL\"\n   833\t            ),\n   834\t            \"fixture_source\": str(FIXTURE_PATH.relative_to(REPO_ROOT)),\n   835\t            \"artifact_hashes\": artifact_hashes,\n   836\t            \"obligations\": obligations,\n   837\t            \"taxonomy_checks\": next(\n   838\t                row\n   839\t                for row in metrics[\"additional_checks\"]\n   840\t                if row[\"id\"] == \"outcome_taxonomy\"\n   841\t            ),\n   842\t            \"regression_check\": next(\n   843\t                row\n   844\t                for row in metrics[\"additional_checks\"]\n   845\t                if row[\"id\"] == \"regression_helper\"\n   846\t            ),\n   847\t            \"metric_pipeline\": metrics[\"metric_pipeline\"],\n   848\t            \"cost\": {\n   849\t                \"model_calls\": 0,\n   850\t                \"endpoint_calls\": 0,\n   851\t            },\n   852\t            \"held_out_result_read\": False,\n   853\t            \"candidate_item_scoring\": False,\n   854\t            \"deviations\": [],\n   855\t        }\n   856\t    )\n   857\t    provenance.write_json_lf(FIXTURE_RECEIPT_PATH, fixture_payload)\n   858\t    _write_prereg(fixtures, preflight)\n   859\t    receipt = provenance.attributed_payload(\n   860\t        {\n   861\t            \"run_id\": RUN_ID,\n   862\t            \"task\": \"tatqa_wp1_loop_a\",\n   863\t            \"status\": (\n   864\t                \"PASS\"\n   865\t                if fixture_payload[\"status\"] == \"PASS\"\n   866\t                and preflight[\"status\"] == \"PASS\"\n   867\t                else \"FAIL\"\n   868\t            ),\n   869\t            \"start_utc\": START_UTC,\n   870\t            \"end_utc\": datetime.now(timezone.utc).strftime(\"%Y-%m-%dT%H:%M:%SZ\"),\n   871\t            \"input_verification\": _verify_pinned_inputs(),\n   872\t            \"artifact_hashes\": artifact_hashes,\n   873\t            \"fixture_results\": obligations,\n   874\t            \"preflight_results\": preflight[\"checks\"],\n   875\t            \"cost\": {\n   876\t                \"model_calls\": 0,\n   877\t                \"endpoint_calls\": 0,\n   878\t            },\n   879\t            \"unverified_items\": [\n   880\t                \"real E/C experience blocks were not constructed\",\n   881\t                \"actor freeze and model selection remain PENDING\",\n   882\t                \"origin-disjoint episode and near-duplicate receipts remain PENDING\",\n   883\t                \"held-out pilot and scientific outcomes remain UNVERIFIED\",\n   884\t            ],\n   885\t            \"deviations\": [],\n   886\t        }\n   887\t    )\n   888\t    provenance.write_json_lf(WP1_RECEIPT_PATH, receipt)\n   889\t\n   890\t\n   891\tdef main() -> int:\n   892\t    fixtures = load_synthetic_fixtures()\n   893\t    obligations, metrics = run_checks(fixtures)\n   894\t    failed_obligations = [\n   895\t        row[\"id\"] for row in obligations if row[\"status\"] != \"PASS\"\n   896\t    ]\n   897\t    failed_additional = [\n   898\t        row[\"id\"]\n   899\t        for row in metrics[\"additional_checks\"]\n   900\t        if row[\"status\"] != \"PASS\"\n   901\t    ]\n   902\t    if (\n   903\t        failed_obligations\n   904\t        or failed_additional\n   905\t        or metrics[\"metric_pipeline\"][\"status\"] != \"PASS\"\n   906\t    ):\n   907\t        failing = failed_obligations + failed_additional\n   908\t        if metrics[\"metric_pipeline\"][\"status\"] != \"PASS\":\n   909\t            failing.append(\"synthetic_metric_pipeline\")\n   910\t        print(f\"SOFTWARE_NOT_QUALIFIED: {','.join(failing)}\")\n   911\t        return 1\n   912\t    write_outputs(fixtures, obligations, metrics)\n   913\t    print(\"WP1_FIXTURES_PASS\")\n   914\t    return 0\n   915\t\n   916\t\n   917\tif __name__ == \"__main__\":\n   918\t    raise SystemExit(main())\n","exit_code":0,"status":"completed"}}

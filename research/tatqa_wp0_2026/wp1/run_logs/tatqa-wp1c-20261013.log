ed explicitly\",\n   640\t    )\n   641\t    return {\n   642\t        \"status\": \"PASS\",\n   643\t        \"fixture_only\": True,\n   644\t        \"aggregate\": aggregate,\n   645\t        \"paired_comparisons\": comparisons,\n   646\t    }\n   647\t\n   648\t\n   649\tdef run_checks(\n   650\t    fixtures: Mapping[str, Any]\n   651\t) -> tuple[list[dict[str, Any]], dict[str, Any]]:\n   652\t    obligations = [\n   653\t        _obligation(\n   654\t            \"prompt_byte_determinism\",\n   655\t            lambda: _check_prompt_byte_determinism(fixtures),\n   656\t        ),\n   657\t        _obligation(\n   658\t            \"hidden_gold_search\",\n   659\t            lambda: _check_hidden_gold_search(fixtures),\n   660\t        ),\n   661\t        _obligation(\n   662\t            \"gold_recomputation\",\n   663\t            lambda: _check_gold_recomputation(fixtures),\n   664\t        ),\n   665\t        _obligation(\n   666\t            \"scale_conversions\",\n   667\t            lambda: _check_scale_conversions(fixtures),\n   668\t        ),\n   669\t        _obligation(\n   670\t            \"unknown_and_refused\",\n   671\t            lambda: _check_unknown_and_refused(fixtures),\n   672\t        ),\n   673\t        _obligation(\n   674\t            \"ec_token_delta\",\n   675\t            lambda: _check_ec_token_delta(fixtures),\n   676\t        ),\n   677\t    ]\n   678\t    additional_checks = [\n   679\t        _obligation(\"outcome_taxonomy\", lambda: _check_taxonomy(fixtures)),\n   680\t        _obligation(\"regression_helper\", lambda: _check_regression(fixtures)),\n","exit_code":0,"status":"completed"}}

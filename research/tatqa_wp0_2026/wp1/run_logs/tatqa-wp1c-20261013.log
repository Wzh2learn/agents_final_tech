d additionally search exact checker/fixture `str()` forms when different;\n+- the mandatory positive control injects every needle, including the `1300`/`1300.0` pair and negative `-55`, and fails if any injection is silent;\n+- byte determinism covers all seven fixtures across all four arms B/E/C/S;\n+- taxonomy exercises all eight classes including `wrong`, while `regressed` excludes only `refused`/`unknown` from otherwise non-correct answers;\n+- all safety booleans in generated receipts carry `derived` or `attested: true` basis labels;\n+- `scoring_inputs_all_synthetic` derives from the instrumented `score_item` call log;\n+- `WP1_RECEIPT.artifact_hashes.fixture_receipt` pins the canonical data receipt, whose tracked repository mirror is byte-identical;\n+- all three receipts declare `spec_revision: \"1.2\"`, and the preregistration skeleton lists the eight outcomes plus pending protocol/item/split/actor freezes and identity-only `target_unit` assignment.\n+\n+This addendum and the preceding run-2 addendum remain historical evidence for run 1/2; run 3 extends those artifacts in place without weakening the specification.\ndiff --git a/research/tatqa_wp0_2026/wp1/implementation_contract.sha256 b/research/tatqa_wp0_2026/wp1/implementation_contract.sha256\nindex 8ee63bc12..e2ddc0aa6 100644\n--- a/research/tatqa_wp0_2026/wp1/implementation_contract.sha256\n+++ b/research/tatqa_wp0_2026/wp1/implementation_contract.sha256\n@@ -1 +1 @@\n-e281248058467de32087ae2ae4138d7506960a96f862154cff1c32ccfb740d06  research/tatqa_wp0_2026/wp1/implementation_contract.md\n+9a715c8f5b56ec016a33e0187f4c507b5e1ad119dace5311aebc1057a705e7eb  research/tatqa_wp0_2026/wp1/implementation_contract.md\ndiff --git a/research/tatqa_wp0_2026/wp1/run_fixtures.py b/research/tatqa_wp0_2026/wp1/run_fixtures.py\nindex 8631e835f..4fa8fa3c7 100644\n--- a/research/tatqa_wp0_2026/wp1/run_fixtures.py\n+++ b/research/tatqa_wp0_2026/wp1/run_fixtures.py\n@@ -19,11 +19,25 @@ DATA_OUT_DIR = REPO_ROOT / \"data/research/tatqa_wp0_2026/wp1\"\n FIXTURE_PATH = WORK_DIR / \"fixtures/synthetic_fixtures.json\"\n PREFLIGHT_PATH = WORK_DIR / \"PREFLIGHT_RECEIPT.json\"\n FIXTURE_RECEIPT_PATH = DATA_OUT_DIR / \"FIXTURE_RECEIPT.json\"\n+FIXTURE_RECEIPT_MIRROR_PATH = WORK_DIR / \"FIXTURE_RECEIPT.json\"\n PREREG_PATH = WORK_DIR / \"PREREG_DRAFT_SKELETON.md\"\n WP1_RECEIPT_PATH = WORK_DIR / \"WP1_RECEIPT.json\"\n-RUN_ID = \"tatqa-wp1b-20261013\"\n+RUN_ID = \"tatqa-wp1c-20261013\"\n+SPEC_REVISION = \"1.2\"\n START_UTC = datetime.now(timezone.utc).strftime(\"%Y-%m-%dT%H:%M:%SZ\")\n BOUNDARY_CHARACTERS = frozenset(\"0123456789.,+-\")\n+SCORE_ITEM_CALL_LOG: list[dict[str, Any]] = []\n+SYNTHETIC_FIXTURE_IDS = frozenset(\n+    {\n+        \"normal_unit\",\n+        \"parentheses_negative\",\n+        \"thousands_separator\",\n+        \"thousand_to_unit\",\n+        \"million_to_thousand\",\n+        \"billion_to_million\",\n+        \"percent_to_percent\",\n+    }\n+)\n PINNED_INPUTS = {\n     REPO_ROOT / \"data/research/tatqa_wp0_2026/candidate_items_v1.json\": (\n         \"bc55fe7a53381f32e5d84ff6c17ced18ec72fd322f98a9f80c4eccb714caac12\"\n@@ -86,6 +100,14 @@ def _obligation(\n     }\n \n \n+def _safety_claim(value: bool, basis: str, evidence: Any) -> dict[str, Any]:\n+    if basis not in {\"derived\", \"attested: true\"}:\n+        raise ValueError(f\"unsupported safety basis: {basis}\")\n+    if basis == \"attested: true\" and value is not True:\n+        raise ValueError(\"attested safety claims must be true\")\n+    return {\"basis\": basis, \"evidence\": evidence, \"value\": value}\n+\n+\n def _boundary_aware_matches(serialized_text: str, needle: str) -> list[str]:\n     pattern = re.compile(\n         rf\"(?<![{re.escape(''.join(sorted(BOUNDARY_CHARACTERS)))}])\"\n@@ -110,21 +132,110 @@ def _raw_projection_values(item: Mapping[str, Any]) -> list[str]:\n     return raw_values\n \n \n+def canonical_plain_decimal(value: Decimal) -> str:\n+    if not isinstance(value, Decimal):\n+        r
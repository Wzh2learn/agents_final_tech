{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,220p' research/tatqa_wp0_2026/wp1/run_fixtures.py; sed -n '380,490p' research/tatqa_wp0_2026/wp1/run_fixtures.py; sed -n '760,850p' research/tatqa_wp0_2026/wp1/run_fixtures.py; sed -n '1,320p' research/tatqa_wp0_2026/wp1/implementation_contract.md; sed -n '1,260p' research/tatqa_wp0_2026/wp1/PREREG_DRAFT_SKELETON.md\"","aggregated_output":"from __future__ import annotations\n\nimport hashlib\nimport json\nfrom datetime import datetime, timezone\nfrom decimal import Decimal\nfrom pathlib import Path\nfrom typing import Any, Callable, Mapping\n\nimport adapter\nimport checker\nimport provenance\n\n\nWORK_DIR = Path(__file__).resolve().parent\nREPO_ROOT = WORK_DIR.parents[2]\nDATA_OUT_DIR = REPO_ROOT / \"data/research/tatqa_wp0_2026/wp1\"\nFIXTURE_PATH = WORK_DIR / \"fixtures/synthetic_fixtures.json\"\nPREFLIGHT_PATH = WORK_DIR / \"PREFLIGHT_RECEIPT.json\"\nFIXTURE_RECEIPT_PATH = DATA_OUT_DIR / \"FIXTURE_RECEIPT.json\"\nPREREG_PATH = WORK_DIR / \"PREREG_DRAFT_SKELETON.md\"\nWP1_RECEIPT_PATH = WORK_DIR / \"WP1_RECEIPT.json\"\nSTART_UTC = \"2026-10-13T10:37:10Z\"\nPINNED_INPUTS = {\n    REPO_ROOT / \"data/research/tatqa_wp0_2026/candidate_items_v1.json\": (\n        \"bc55fe7a53381f32e5d84ff6c17ced18ec72fd322f98a9f80c4eccb714caac12\"\n    ),\n    REPO_ROOT / \"data/research/tatqa_wp0_2026/origin_manifest.json\": (\n        \"3718e6fef4d52bec0c1c29b47ba9ab60e298754b9e8527835d09c9d223d70cea\"\n    ),\n    REPO_ROOT / \"data/research/tatqa_raw_2026/tatqa_dataset_train.json\": (\n        \"2df6e722cdbaaa37efcbfb280f5c9a15be29a6ec18f618ef936fe63cc6d07c69\"\n    ),\n    REPO_ROOT / \"data/research/tatqa_raw_2026/tatqa_dataset_dev.json\": (\n        \"8da095a819af6db3c14877c6df2d4d29960e41d1a63dd1fa853507bd2a616af5\"\n    ),\n}\n\n\ndef sha256_file(path: Path) -> str:\n    digest = hashlib.sha256()\n    with path.open(\"rb\") as handle:\n        for chunk in iter(lambda: handle.read(1024 * 1024), b\"\"):\n            digest.update(chunk)\n    return digest.hexdigest()\n\n\ndef load_json(path: Path) -> Any:\n    return json.loads(path.read_text(encoding=\"utf-8\"))\n\n\ndef load_synthetic_fixtures() -> dict[str, Any]:\n    fixtures = load_json(FIXTURE_PATH)\n    if fixtures.get(\"schema\") != \"tatqa_wp1_synthetic_fixtures_v1\":\n        raise ValueError(\"unexpected synthetic fixture schema\")\n    return fixtures\n\n\ndef fixture_item(fixture: Mapping[str, Any]) -> dict[str, Any]:\n    return dict(fixture[\"item\"])\n\n\ndef _require(condition: bool, message: str) -> None:\n    if not condition:\n        raise AssertionError(message)\n\n\ndef _obligation(\n    obligation_id: str, check: Callable[[], Mapping[str, Any]]\n) -> dict[str, Any]:\n    try:\n        evidence = dict(check())\n    except Exception as exc:\n        return {\n            \"id\": obligation_id,\n            \"status\": \"FAIL\",\n            \"error\": f\"{type(exc).__name__}: {exc}\",\n        }\n    return {\n        \"id\": obligation_id,\n        \"status\": \"PASS\",\n        \"evidence\": evidence,\n    }\n\n\ndef _check_prompt_byte_determinism(\n    fixtures: Mapping[str, Any]\n) -> Mapping[str, Any]:\n    fixture = fixtures[\"fixtures\"][0]\n    item = fixture_item(fixture)\n    hook = adapter.ContextHook(\"E\", \"experience\", \"synthetic typed placeholder\")\n    first = adapter.build_prompt(item, hook).encode(\"utf-8\")\n    second = adapter.build_prompt(item, hook).encode(\"utf-8\")\n    _require(first == second, \"same item and arm produced different prompt bytes\")\n    return {\n        \"fixture_id\": fixture[\"fixture_id\"],\n        \"first_sha256\": hashlib.sha256(first).hexdigest(),\n        \"second_sha256\": hashlib.sha256(second).hexdigest(),\n        \"byte_equal\": True,\n        \"bytes\": len(first),\n    }\n\n\ndef _check_hidden_gold_search(fixtures: Mapping[str, Any]) -> Mapping[str, Any]:\n    fixture = fixtures[\"fixtures\"][0]\n    item = fixture_item(fixture)\n    prompt = adapter.build_prompt(item, adapter.ContextHook(\"B\", \"none\", \"\"))\n    forbidden_keys = [\n        \"gold_delta_source_unit\",\n        \"gold_recompute_rule\",\n        \"gold_delta_target_unit\",\n        \"expected_gold\",\n        \"origin_id\",\n        \"item_id\",\n    ]\n    forbidden_found = [key for key in forbidden_keys if key in prompt]\n    expected_gold_strings = [\n        value for value in fixture[\"expected_gold\"].values() if len(value) >= 2\n    ]\n    leaked_gold = [\n        value for value in expected_gold_strings if value in prompt\n    ]\n    _require(not forbidden_found, f\"hidden keys leaked: {forbidden_found}\")\n    _require(not leaked_gold, f\"hidden gold leaked: {leaked_gold}\")\n    return {\n        \"fixture_id\": fixture[\"fixture_id\"],\n        \"forbidden_keys_checked\": forbidden_keys,\n        \"gold_strings_checked\": expected_gold_strings,\n        \"forbidden_found\": forbidden_found,\n        \"gold_found\": leaked_gold,\n        \"clean\": True,\n    }\n\n\ndef _check_gold_recomputation(fixtures: Mapping[str, Any]) -> Mapping[str, Any]:\n    results = []\n    for fixture in fixtures[\"fixtures\"]:\n        gold = checker.recompute_gold(fixture_item(fixture))\n        expected = fixture[\"expected_gold\"]\n        comparisons = {\n            \"late_value\": gold.late_value,\n            \"early_value\": gold.early_value,\n            \"delta_source\": gold.delta_source,\n            \"delta_target\": gold.delta_target,\n        }\n        for field, actual in comparisons.items():\n            _require(\n                actual == Decimal(expected[field]),\n                f\"{fixture['fixture_id']} {field}: {actual} != {expected[field]}\",\n            )\n        results.append(\n            {\n                \"fixture_id\": fixture[\"fixture_id\"],\n                \"late_value\": str(gold.late_value),\n                \"early_value\": str(gold.early_value),\n                \"delta_source\": str(gold.delta_source),\n                \"delta_target\": str(gold.delta_target),\n            }\n        )\n    _require(len(results) >= 5, \"fewer than five recomputation fixtures\")\n    fixture_ids = {row[\"fixture_id\"] for row in results}\n    _require(\n        {\"parentheses_negative\", \"thousands_separator\"}.issubset(fixture_ids),\n        \"mandated parsing fixtures are missing\",\n    )\n    return {\n        \"fixture_count\": len(results),\n        \"results\": results,\n        \"mandated_cases_present\": [\n            \"parentheses_negative\",\n            \"thousands_separator\",\n        ],\n    }\n\n\ndef _check_scale_conversions(fixtures: Mapping[str, Any]) -> Mapping[str, Any]:\n    expected_conversions = {\n        \"thousand_to_unit\": Decimal(1000),\n        \"million_to_thousand\": Decimal(1000),\n        \"billion_to_million\": Decimal(1000),\n        \"percent_to_percent\": Decimal(1),\n    }\n    fixture_map = {\n        fixture[\"fixture_id\"]: fixture for fixture in fixtures[\"fixtures\"]\n    }\n    results = []\n    for fixture_id, expected_factor in expected_conversions.items():\n        fixture = fixture_map[fixture_id]\n        item = fixture_item(fixture)\n        actual_factor = checker.conversion_factor(\n            item[\"source_unit\"], item[\"target_unit\"]\n        )\n        gold = checker.recompute_gold(item)\n        _require(\n            actual_factor == expected_factor,\n            f\"{fixture_id} factor {actual_factor} != {expected_factor}\",\n        )\n        _require(\n            gold.delta_target == Decimal(fixture[\"expected_gold\"][\"delta_target\"]),\n            f\"{fixture_id} converted gold mismatch\",\n        )\n        results.append(\n            {\n                \"fixture_id\": fixture_id,\n                \"source_unit\": item[\"source_unit\"],\n                \"target_unit\": item[\"target_unit\"],\n                \"factor\": str(actual_factor),\n                \"delta_source\": str(gold.delta_source),\n                \"delta_target\": str(gold.delta_target),\n            }\n        )\n    return {\n        \"conversion_count\": len(results),\n        \"required_conversions\": list(expected_conversions),\n        \"results\": results,\n    }\n\n\ndef _check_unknown_and_refused(\n    fixtures: Mapping[str, Any]\n        \"status\": \"PASS\",\n        \"fixture_only\": True,\n        \"aggregate\": aggregate,\n        \"paired_comparisons\": comparisons,\n    }\n\n\ndef run_checks(\n    fixtures: Mapping[str, Any]\n) -> tuple[list[dict[str, Any]], dict[str, Any]]:\n    obligations = [\n        _obligation(\n            \"prompt_byte_determinism\",\n            lambda: _check_prompt_byte_determinism(fixtures),\n        ),\n        _obligation(\n            \"hidden_gold_search\",\n            lambda: _check_hidden_gold_search(fixtures),\n        ),\n        _obligation(\n            \"gold_recomputation\",\n            lambda: _check_gold_recomputation(fixtures),\n        ),\n        _obligation(\n            \"scale_conversions\",\n            lambda: _check_scale_conversions(fixtures),\n        ),\n        _obligation(\n            \"unknown_and_refused\",\n            lambda: _check_unknown_and_refused(fixtures),\n        ),\n        _obligation(\n            \"ec_token_delta\",\n            lambda: _check_ec_token_delta(fixtures),\n        ),\n    ]\n    additional_checks = [\n        _obligation(\"outcome_taxonomy\", lambda: _check_taxonomy(fixtures)),\n        _obligation(\"regression_helper\", lambda: _check_regression(fixtures)),\n    ]\n    metric_pipeline = _run_metric_pipeline(fixtures)\n    return obligations, {\n        \"status\": \"PASS\",\n        \"additional_checks\": additional_checks,\n        \"metric_pipeline\": metric_pipeline,\n    }\n\n\ndef _verify_pinned_inputs() -> dict[str, Any]:\n    hashes = {}\n    for path, expected in PINNED_INPUTS.items():\n        actual = sha256_file(path)\n        if actual != expected:\n            raise RuntimeError(\n                f\"HASH_MISMATCH: {path.relative_to(REPO_ROOT)} {actual} != {expected}\"\n            )\n        hashes[str(path.relative_to(REPO_ROOT))] = actual\n    candidate_path = REPO_ROOT / \"data/research/tatqa_wp0_2026/candidate_items_v1.json\"\n    origin_path = REPO_ROOT / \"data/research/tatqa_wp0_2026/origin_manifest.json\"\n    generation_receipt_path = (\n        REPO_ROOT / \"data/research/tatqa_wp0_2026/GENERATION_RECEIPT.json\"\n    )\n    candidates = load_json(candidate_path)\n    origins = load_json(origin_path)\n    generation_receipt = load_json(generation_receipt_path)\n    counts = {\n        \"candidate_items\": len(candidates[\"items\"]),\n        \"candidate_item_count_field\": candidates[\"item_count\"],\n        \"origins\": len(origins[\"origins\"]),\n        \"origin_count_field\": origins[\"origin_count\"],\n        \"receipt_candidate_items\": generation_receipt[\"candidate_items\"],\n        \"receipt_origins\": generation_receipt[\"origins\"],\n    }\n    expected_counts = {\n        \"candidate_items\": 60,\n        \"candidate_item_count_field\": 60,\n        \"origins\": 182,\n        \"origin_count_field\": 182,\n        \"receipt_candidate_items\": 60,\n        \"receipt_origins\": 182,\n    }\n    if counts != expected_counts:\n        raise RuntimeError(f\"HASH_MISMATCH_COUNTS: {counts} != {expected_counts}\")\n    return {\n        \"status\": \"PASS\",\n        \"hashes\": hashes,\n        \"counts\": counts,\n    }\n\n\ndef _preflight_checks(fixtures: Mapping[str, Any]) -> dict[str, Any]:\n    input_verification = _verify_pinned_inputs()\n    required_paths = [\n        WORK_DIR / \"checker.py\",\n        WORK_DIR / \"adapter.py\",\n        WORK_DIR / \"provenance.py\",\n        WORK_DIR / \"run_fixtures.py\",\n        WORK_DIR / \"implementation_contract.md\",\n        WORK_DIR / \"implementation_contract.sha256\",\n        WORK_DIR / \"PREREG_DRAFT_SKELETON.md\",\n        FIXTURE_PATH,\n    ]\n    required_files = {\n        str(path.relative_to(REPO_ROOT)): path.exists() for path in required_paths\n    }\n    if not all(required_files.values()):\n        missing = [path for path, exists in required_files.items() if not exists]\n        raise RuntimeError(f\"required files missing: {missing}\")\n    candidate_path = REPO_ROOT / \"data/research/tatqa_wp0_2026/candidate_items_v1.json\"\n    origin_path = REPO_ROOT / \"data/research/tatqa_wp0_2026/origin_manifest.json\"\n    candidates = load_json(candidate_path)\n                    row[\"status\"] == \"PASS\"\n                    for row in metrics[\"additional_checks\"]\n                )\n                and metrics[\"metric_pipeline\"][\"status\"] == \"PASS\"\n                else \"FAIL\"\n            ),\n            \"fixture_source\": str(FIXTURE_PATH.relative_to(REPO_ROOT)),\n            \"obligations\": obligations,\n            \"taxonomy_checks\": next(\n                row\n                for row in metrics[\"additional_checks\"]\n                if row[\"id\"] == \"outcome_taxonomy\"\n            ),\n            \"regression_check\": next(\n                row\n                for row in metrics[\"additional_checks\"]\n                if row[\"id\"] == \"regression_helper\"\n            ),\n            \"metric_pipeline\": metrics[\"metric_pipeline\"],\n            \"cost\": {\n                \"model_calls\": 0,\n                \"endpoint_calls\": 0,\n            },\n            \"held_out_result_read\": False,\n            \"candidate_item_scoring\": False,\n            \"deviations\": [],\n        }\n    )\n    provenance.write_json_lf(FIXTURE_RECEIPT_PATH, fixture_payload)\n    _write_prereg(fixtures, preflight)\n    artifact_hashes = {\n        \"checker\": sha256_file(WORK_DIR / \"checker.py\"),\n        \"adapter\": sha256_file(WORK_DIR / \"adapter.py\"),\n        \"fixtures\": sha256_file(FIXTURE_PATH),\n        \"preflight\": sha256_file(PREFLIGHT_PATH),\n        \"contract\": sha256_file(WORK_DIR / \"implementation_contract.md\"),\n    }\n    receipt = provenance.attributed_payload(\n        {\n            \"task\": \"tatqa_wp1_loop_a\",\n            \"status\": (\n                \"PASS\"\n                if fixture_payload[\"status\"] == \"PASS\"\n                and preflight[\"status\"] == \"PASS\"\n                else \"FAIL\"\n            ),\n            \"start_utc\": START_UTC,\n            \"end_utc\": datetime.now(timezone.utc).strftime(\"%Y-%m-%dT%H:%M:%SZ\"),\n            \"input_verification\": _verify_pinned_inputs(),\n            \"artifact_hashes\": artifact_hashes,\n            \"fixture_results\": obligations,\n            \"preflight_results\": preflight[\"checks\"],\n            \"cost\": {\n                \"model_calls\": 0,\n                \"endpoint_calls\": 0,\n            },\n            \"unverified_items\": [\n                \"real E/C experience blocks were not constructed\",\n                \"actor freeze and model selection remain PENDING\",\n                \"origin-disjoint episode and near-duplicate receipts remain PENDING\",\n                \"held-out pilot and scientific outcomes remain UNVERIFIED\",\n            ],\n            \"deviations\": [],\n        }\n    )\n    provenance.write_json_lf(WP1_RECEIPT_PATH, receipt)\n\n\ndef main() -> int:\n    fixtures = load_synthetic_fixtures()\n    obligations, metrics = run_checks(fixtures)\n    failed_obligations = [\n        row[\"id\"] for row in obligations if row[\"status\"] != \"PASS\"\n    ]\n    failed_additional = [\n        row[\"id\"]\n        for row in metrics[\"additional_checks\"]\n        if row[\"status\"] != \"PASS\"\n    ]\n    if (\n        failed_obligations\n        or failed_additional\n        or metrics[\"metric_pipeline\"][\"status\"] != \"PASS\"\n    ):\n        failing = failed_obligations + failed_additional\n        if metrics[\"metric_pipeline\"][\"status\"] != \"PASS\":\n            failing.append(\"synthetic_metric_pipeline\")\n        print(f\"SOFTWARE_NOT_QUALIFIED: {','.join(failing)}\")\n        return 1\n    write_outputs(fixtures, obligations, metrics)\n    print(\"WP1_FIXTURES_PASS\")\n# WP-1 Implementation Contract\n\nTask: `tatqa_wp1_loop_a`\n\nScope: implement the thin checker, deterministic adapter, synthetic fixture runner, preflight receipt, and preregistration draft for TAT-QA WP-1. This contract authorizes no candidate-item scoring, model call, endpoint call, episode collection, training, service access, database access, network access, commit, or push.\n\nWrite paths:\n\n- `research/tatqa_wp0_2026/wp1/`\n- `data/research/tatqa_wp0_2026/wp1/`\n\nRuntime and style:\n\n- Python 3.12 standard library only.\n- UTF-8 input and LF-terminated JSON/Markdown outputs.\n- Synthetic fixtures only for execution.\n- Fail closed if any fixture obligation or preflight check fails.\n\n## 1. Module list and signatures\n\n### `research/tatqa_wp0_2026/wp1/checker.py`\n\n```python\nSCALES: dict[str, Decimal]\nREQUIRED_RUNTIME_FIELDS: frozenset[str]\nCORRECT_OUTCOMES: frozenset[str]\n\n@dataclass(frozen=True)\nclass Gold:\n    late_value: Decimal\n    early_value: Decimal\n    delta_source: Decimal\n    delta_target: Decimal\n    source_unit: str\n    target_unit: str\n\n@dataclass(frozen=True)\nclass PreparedItem:\n    item_id: str\n    origin_id: str\n    row_label: str\n    late_period: str\n    early_period: str\n    gold: Gold\n\ndef normalize_unit(unit: str | None) -> str: ...\ndef parse_numeric_cell(value: str | int | float) -> Decimal: ...\ndef conversion_factor(source_unit: str, target_unit: str) -> Decimal: ...\ndef recompute_gold(item: Mapping[str, Any]) -> Gold: ...\ndef prepare_item(item: Mapping[str, Any]) -> PreparedItem: ...\ndef parse_answer(answer_text: str) -> dict[str, Any] | None: ...\ndef score_prepared(prepared: PreparedItem, answer_text: str) -> dict[str, str]: ...\ndef score_item(item: Mapping[str, Any], answer_text: str) -> dict[str, str]: ...\ndef apply_regression(base_outcome: str, arm_outcome: str) -> str: ...\ndef aggregate_outcomes(records: Iterable[Mapping[str, Any]]) -> dict[str, Any]: ...\ndef paired_origin_differences(\n    records: Iterable[Mapping[str, Any]],\n    left_arm: str,\n    right_arm: str,\n) -> dict[str, Any]: ...\n```\n\nGold construction is separated from answer parsing. `score_item` constructs `PreparedItem` before it passes `answer_text` into `score_prepared`. Numeric parsing removes thousands separators and treats surrounding parentheses as negative. Supported scale keys are `unit`, `thousand`, `million`, `billion`, and `percent`; conversion uses the ratio of their scale exponents.\n\nOutcome precedence:\n\n1. Literal `REFUSED` -> `refused`.\n2. Literal `UNKNOWN`, timeout marker, or unparseable JSON -> `unknown`.\n3. Row mismatch -> `wrong`.\n4. Reversed period order with both values negated -> `correct_other_form`.\n5. Any other period mismatch -> `wrong_period`.\n6. Source value correct and target value wrong -> `wrong_unit`.\n7. Both values correct -> `correct`.\n8. Otherwise -> `wrong`.\n\n`regressed` is assigned only by `apply_regression` when a B outcome in `{correct, correct_other_form}` becomes a non-correct answer other than `refused` or `unknown`; refusals and unknowns remain first-class.\n\n### `research/tatqa_wp0_2026/wp1/adapter.py`\n\n```python\nARMS: frozenset[str]\nCONTEXT_HOOK_TYPES: Mapping[str, str]\nANSWER_FORMAT: str\n\n@dataclass(frozen=True)\nclass ContextHook:\n    arm: str\n    hook_type: str\n    text: str\n\n@dataclass(frozen=True)\nclass Projection:\n    row_label: str\n    period_late: str\n    period_early: str\n    source_unit: str\n    target_unit: str\n    requested_quantity: str\n    table: list[list[str]]\n\ndef runtime_payload_from_candidate(item: Mapping[str, Any]) -> dict[str, Any]: ...\ndef projection_from_candidate(item: Mapping[str, Any]) -> Projection: ...\ndef validate_context_hook(hook: ContextHook) -> None: ...\ndef build_prompt(item: Mapping[str, Any], hook: ContextHook) -> str: ...\ndef count_context_tokens(text: str) -> int: ...\ndef context_token_delta(\n    e_text: str,\n    c_text: str,\n    relative_limit: Decimal = Decimal(\"0.05\"),\n) -> dict[str, Any]: ...\n```\n\nThe prompt is deterministic UTF-8 JSON text with no timestamp, random value, item id, origin id, gold field, gold value key, or hidden recomputation rule. The complete table is serialized without truncation. Arm hooks are typed as `none`, `experience`, `matched_experience`, or `static_rules`; the adapter serializes supplied typed placeholder text and does not construct real experience blocks.\n\nToken accounting uses a documented deterministic lexical proxy: non-whitespace tokens from `re.findall(r\"\\\\S+\", text)`. It is not a model tokenizer estimate.\n\n### `research/tatqa_wp0_2026/wp1/provenance.py`\n\n```python\nTASK: str\n\ndef task_provenance() -> dict[str, Any]: ...\ndef attributed_payload(payload: Mapping[str, Any]) -> dict[str, Any]: ...\ndef write_json_lf(path: str | Path, payload: Mapping[str, Any]) -> None: ...\n```\n\nThe writer attributes every generated receipt to `tatqa_wp1_loop_a`, records `model_calls=0`, and records `endpoint_calls=0`.\n\n### `research/tatqa_wp0_2026/wp1/run_fixtures.py`\n\n```python\nWORK_DIR: Path\nDATA_OUT_DIR: Path\nFIXTURE_PATH: Path\n\ndef load_synthetic_fixtures() -> dict[str, Any]: ...\ndef fixture_item(fixture: Mapping[str, Any]) -> dict[str, Any]: ...\ndef run_checks(fixtures: Mapping[str, Any]) -> tuple[list[dict[str, Any]], dict[str, Any]]: ...\ndef write_outputs(fixtures: Mapping[str, Any], obligations: list[dict[str, Any]], metrics: dict[str, Any]) -> None: ...\ndef main() -> int: ...\n```\n\n### `research/tatqa_wp0_2026/wp1/fixtures/synthetic_fixtures.json`\n\nSchema: `tatqa_wp1_synthetic_fixtures_v1`.\n\nRequired fixtures:\n\n- `normal_unit`: ordinary two-cell recomputation.\n- `parentheses_negative`: parenthesized early value becomes negative.\n- `thousands_separator`: comma-separated cells are parsed as thousands separators.\n- `thousand_to_unit`\n- `million_to_thousand`\n- `billion_to_million`\n- `percent_to_percent`\n\nThe first seven fixtures provide seven hand-built recomputations, including the two mandated parsing cases and all four mandated conversions. Answer fixtures cover `correct`, `correct_other_form`, `wrong_unit`, `wrong_period`, `refused`, and `unknown`.\n\nThe E and C placeholder contexts are synthetic strings with a measured lexical token delta declared in the fixture file. They are not episodes and are not real experience blocks.\n\n## 2. Fixture obligations\n\n`run_fixtures.py` must execute exactly these six obligations and emit one result object per obligation:\n\n1. `prompt_byte_determinism`: build the same synthetic item plus identical hook twice and compare encoded UTF-8 bytes.\n2. `hidden_gold_search`: reject hidden key names and ensure the expected gold decimal strings are absent from the actor-visible prompt.\n3. `gold_recomputation`: compare `recompute_gold` results to at least five hand-computed expected values, including parentheses-negative and thousands-separator cases.\n4. `scale_conversions`: compare all four specified unit conversions.\n5. `unknown_and_refused`: classify literal `UNKNOWN` and `REFUSED` correctly, plus unparseable JSON as unknown.\n6. `ec_token_delta`: compute lexical token counts, absolute delta, relative delta, and pass/fail against the fixture's 5% limit.\n\nAdditional non-obligation synthetic checks are permitted only to exercise the declared checker taxonomy, regression helper, provenance writer, and metric pipeline. They must use fixture origin/item ids only.\n\n## 3. Preflight schema\n\n`research/tatqa_wp0_2026/wp1/PREFLIGHT_RECEIPT.json` uses schema `tatqa_wp1_preflight_receipt_v1` and contains:\n\n```json\n{\n  \"schema\": \"tatqa_wp1_preflight_receipt_v1\",\n  \"task\": \"tatqa_wp1_loop_a\",\n  \"status\": \"PASS\",\n  \"provenance\": {},\n  \"required_files\": {},\n  \"runtime_schema\": {},\n  \"checker_domain\": {},\n  \"identifier_resolution\": {},\n  \"metric_pipeline\": {},\n  \"held_out_result_read\": false,\n  \"checks\": []\n}\n```\n\nThe preflight reads only the pinned candidate/origin metadata needed to validate structure, field names, checker-domain coverage, and identifier resolution. It does not call `recompute_gold`, `score_item`, or any metric on candidate items and does not read any candidate gold field.\n\n## 4. Generated receipt schemas\n\n`data/research/tatqa_wp0_2026/wp1/FIXTURE_RECEIPT.json` uses schema `tatqa_wp1_fixture_receipt_v1` and contains `task`, `status`, `provenance`, `obligations`, `taxonomy_checks`, `regression_check`, `metric_pipeline`, `cost`, and `deviations`.\n\n`research/tatqa_wp0_2026/wp1/PREREG_DRAFT_SKELETON.md` is a draft-only Markdown file. Actor revision, model, settings, real episode context, analysis implementation, budget/window, and advisor/owner decisions remain exactly `PENDING`.\n\n`research/tatqa_wp0_2026/wp1/WP1_RECEIPT.json` uses schema `tatqa_wp1_receipt_v1` and contains:\n\n```json\n{\n  \"task\": \"tatqa_wp1_loop_a\",\n  \"status\": \"PASS\",\n  \"start_utc\": \"YYYY-MM-DDTHH:MM:SSZ\",\n  \"end_utc\": \"YYYY-MM-DDTHH:MM:SSZ\",\n  \"input_verification\": {\n    \"hashes\": {},\n    \"counts\": {},\n    \"status\": \"PASS\"\n  },\n  \"artifact_hashes\": {\n    \"checker\": \"\",\n    \"adapter\": \"\",\n    \"fixtures\": \"\",\n    \"preflight\": \"\",\n    \"contract\": \"\"\n  },\n  \"fixture_results\": [],\n  \"preflight_results\": [],\n  \"cost\": {\n    \"model_calls\": 0,\n    \"endpoint_calls\": 0\n  },\n  \"unverified_items\": [],\n  \"deviations\": []\n}\n```\n\n## 5. Exact commands\n\nThe implementation must not run a model, endpoint, service, database, training command, network command, loop verifier, commit, or push.\n\nAfter this contract is written, hash it before creating or running implementation files:\n\n```bash\ncd /home/testuser/wzh/projects/agents_final_tech\nsha256sum research/tatqa_wp0_2026/wp1/implementation_contract.md > research/tatqa_wp0_2026/wp1/implementation_contract.sha256\nsha256sum -c research/tatqa_wp0_2026/wp1/implementation_contract.sha256\n```\n\nImplementation and validation:\n\n```bash\ncd /home/testuser/wzh/projects/agents_final_tech\npython3 -m py_compile research/tatqa_wp0_2026/wp1/checker.py research/tatqa_wp0_2026/wp1/adapter.py research/tatqa_wp0_2026/wp1/provenance.py research/tatqa_wp0_2026/wp1/run_fixtures.py\npython3 research/tatqa_wp0_2026/wp1/run_fixtures.py\npython3 -m json.tool research/tatqa_wp0_2026/wp1/PREFLIGHT_RECEIPT.json >/dev/null\npython3 -m json.tool data/research/tatqa_wp0_2026/wp1/FIXTURE_RECEIPT.json >/dev/null\npython3 -m json.tool research/tatqa_wp0_2026/wp1/WP1_RECEIPT.json >/dev/null\n```\n\nFinal artifact verification:\n\n```bash\ncd /home/testuser/wzh/projects/agents_final_tech\nsha256sum research/tatqa_wp0_2026/wp1/checker.py research/tatqa_wp0_2026/wp1/adapter.py research/tatqa_wp0_2026/wp1/fixtures/synthetic_fixtures.json research/tatqa_wp0_2026/wp1/PREFLIGHT_RECEIPT.json research/tatqa_wp0_2026/wp1/implementation_contract.md\ngit status --short -- research/tatqa_wp0_2026/wp1 data/research/tatqa_wp0_2026/wp1\n```\n\n## 6. Stop conditions\n\n- Pinned input hash mismatch: report `HASH_MISMATCH` and stop.\n- Any of the six fixture obligations fails: report `SOFTWARE_NOT_QUALIFIED` with the failed obligation and stop without changing the fixture to force a pass.\n- Any required forbidden action: stop and report the blocked requirement.\n- No scientific result, pilot result, candidate-item score, or held-out outcome is permitted in any receipt.\n# TAT-QA WP-2 Preregistration Draft Skeleton\n\nStatus: `DRAFT - NOT READY - NO PILOT AUTHORIZATION`\n\nTask: `tatqa_wp1_loop_a`\n\nThis skeleton freezes no experiment and authorizes no model call. All actor, context, budget, window, and governance fields remain pending until owner/advisor selection and approval.\n\n## 1. Scientif
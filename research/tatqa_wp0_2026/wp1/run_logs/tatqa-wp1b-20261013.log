182,\n   457\t        \"origin_count_field\": 182,\n   458\t        \"receipt_candidate_items\": 60,\n   459\t        \"receipt_origins\": 182,\n   460\t    }\n   461\t    if counts != expected_counts:\n   462\t        raise RuntimeError(f\"HASH_MISMATCH_COUNTS: {counts} != {expected_counts}\")\n   463\t    return {\n   464\t        \"status\": \"PASS\",\n   465\t        \"hashes\": hashes,\n   466\t        \"counts\": counts,\n   467\t    }\n   468\t\n   469\t\n   470\tdef _preflight_checks(fixtures: Mapping[str, Any]) -> dict[str, Any]:\n   471\t    input_verification = _verify_pinned_inputs()\n   472\t    required_paths = [\n   473\t        WORK_DIR / \"checker.py\",\n   474\t        WORK_DIR / \"adapter.py\",\n   475\t        WORK_DIR / \"provenance.py\",\n   476\t        WORK_DIR / \"run_fixtures.py\",\n   477\t        WORK_DIR / \"implementation_contract.md\",\n   478\t        WORK_DIR / \"implementation_contract.sha256\",\n   479\t        WORK_DIR / \"PREREG_DRAFT_SKELETON.md\",\n   480\t        FIXTURE_PATH,\n   620\t            \"status\": \"PASS\" if checker_domain_pass else \"FAIL\",\n   621\t            \"allowed_candidate_structures\": len(runtime_payloads),\n   622\t            \"checker_functions_defined\": sorted(\n   623\t                name\n   624\t                for name in [\n   625\t                    \"recompute_gold\",\n   626\t                    \"prepare_item\",\n   627\t                    \"score_item\",\n   628\t                    \"apply_regression\",\n   629\t                    \"aggregate_outcomes\",\n   630\t                    \"paired_origin_differences\",\n   631\t                ]\n   632\t                if callable(getattr(checker, name, None))\n   633\t            ),\n   634\t            \"candidate_scoring_called\": False,\n   635\t            \"candidate_gold_fields_accessed\": False,\n   636\t        },\n   637\t        \"identifier_resolution\": {\n   638\t            \"status\": \"PASS\" if identifier_pass else \"FA
n keys leaked: {forbidden_found}\")\n   124\t    _require(not leaked_gold, f\"hidden gold leaked: {leaked_gold}\")\n   125\t    return {\n   126\t        \"fixture_id\": fixture[\"fixture_id\"],\n   127\t        \"forbidden_keys_checked\": forbidden_keys,\n   128\t        \"gold_strings_checked\": expected_gold_strings,\n   129\t        \"forbidden_found\": forbidden_found,\n   130\t        \"gold_found\": leaked_gold,\n   131\t        \"clean\": True,\n   132\t    }\n   133\t\n   134\t\n   135\tdef _check_gold_recomputation(fixtures: Mapping[str, Any]) -> Mapping[str, Any]:\n   136\t    results = []\n   137\t    for fixture in fixtures[\"fixtures\"]:\n   138\t        gold = checker.recompute_gold(fixture_item(fixture))\n   139\t        expected = fixture[\"expected_gold\"]\n   140\t        comparisons = {\n   141\t            \"late_value\": gold.late_value,\n   142\t            \"early_value\": gold.early_value,\n   143\t            \"delta_source\": gold.delta_source,\n   144\t            \"delta_target\": gold.delta_target,\n   145\t        }\n   146\t        for field, actual in comparisons.items():\n   147\t            _require(\n   148\t                actual == Decimal(expected[field]),\n   149\t                f\"{fixture['fixture_id']} {field}: {actual} != {expected[field]}\",\n   150\t            )\n   151\t        results.append(\n   152\t            {\n   153\t                \"fixture_id\": fixture[\"fixture_id\"],\n   154\t                \"late_value\": str(gold.late_value),\n   155\t                \"early_value\": str(gold.early_value),\n   156\t                \"delta_source\": str(gold.delta_source),\n   157\t                \"delta_target\": str(gold.delta_target),\n   158\t            }\n   159\t        )\n   160\t    _require(len(results) >= 5, \"fewer than five recomputation fixtures\")\n   161\t    fixture_ids = {row[\"fixture_id\"] for row in results}\n   162\t    _require(\n   163\t        {\"parentheses_negative\", \"thousands_separator\"
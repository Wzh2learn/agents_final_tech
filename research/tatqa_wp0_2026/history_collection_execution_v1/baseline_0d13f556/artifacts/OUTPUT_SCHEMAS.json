{
  "schema": "collection_output_schemas_v1",
  "plan": {
    "type": "object",
    "additionalProperties": false,
    "required": ["tool", "params"],
    "properties": {
      "tool": {"const": "calc"},
      "params": {
        "type": "object",
        "additionalProperties": false,
        "required": ["expression"],
        "properties": {
          "expression": {"type": "string", "minLength": 1, "maxLength": 200}
        }
      }
    }
  },
  "consume": {
    "type": "object",
    "additionalProperties": false,
    "required": ["status", "delta_target", "unit"],
    "properties": {
      "status": {"enum": ["ANSWER", "UNKNOWN", "REFUSE"]},
      "delta_target": {"type": ["number", "null"]},
      "unit": {"type": ["string", "null"], "maxLength": 64}
    }
  }
}

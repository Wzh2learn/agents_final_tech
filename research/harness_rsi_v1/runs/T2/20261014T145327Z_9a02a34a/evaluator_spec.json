      "legal": [
        "NEGATIVE_RESULT_STOPPED_AND_PENDING_REVIEW"
      ],
      "review": [
        "SCIENTIFIC_STATUS_WORDING_REVIEW"
      ]
    }
  },
  "status_precedence": [
    "FAIL",
    "REVIEW_REQUIRED",
    "PASS",
    "NOT_EVALUATED"
  ],
  "decision_rule": {
    "BLOCK": "At least one dimension is FAIL.",
    "REVIEW_REQUIRED": "No dimension is FAIL and at least one dimension is REVIEW_REQUIRED or NOT_EVALUATED.",
    "ALLOW_WITHIN_SCOPE": "All three dimensions are PASS.",
    "fail_closed": "Invalid, incomplete, empty or mis-bound input returns REVIEW_REQUIRED, statuses NOT_EVALUATED, a fail_closed_code, and exit code 3."

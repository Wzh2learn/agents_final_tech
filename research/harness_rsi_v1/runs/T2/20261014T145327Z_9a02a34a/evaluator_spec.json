  "fail_closed_codes": [
    "FC_MISSING_REQUIRED_FIELD",
    "FC_INVALID_ENUM_VALUE",
    "FC_EMPTY_EVIDENCE_SET",
    "FC_HASH_BINDING_MISMATCH",
    "FC_UNSUPPORTED_HASH_DOMAIN",
    "FC_PATH_OUTSIDE_ALLOWLIST",
    "FC_UNKNOWN_ASSERTION_SIGNATURE",
    "FC_SIGNATURE_FAMILY_MISMATCH",
    "FC_CANDIDATE_OWNERSHIP_VIOLATION",
    "FC_INPUT_NOT_JSON_OBJECT"

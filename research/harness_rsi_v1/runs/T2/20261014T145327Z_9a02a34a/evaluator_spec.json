        "ENGINEERING_FAILURE_PENDING_SCIENCE",
        "USAGE_METERING_UNRESOLVED"
      ]
    },
    "数据与统计": {
      "defect": [
        "SPLIT_LEAKAGE",
        "DENOMINATOR_DRIFT",
        "SILENT_EXCLUSION"
      ],
      "legal": [
        "FROZEN_SPLIT_AND_EXCLUSION_APPLIED"
      ]
    },
    "测量对象": {
      "defect": [
        "DOWNSTREAM_MEASUREMENT_NOT_RECOMPUTED"

    "axis_separation": "R, C and S are independent directions. This artifact evaluates only R and never produces a cross-direction aggregate score.",
    "qualification_claim": "Engineering qualification only; no formal experiment authority and no scientific PASS."
  },
  "input_contract": {
    "schema": "case_bundle",
    "required_fields": [
      "schema",
      "bundle_id",
      "direction",
      "case_kind",
      "failure_family",
      "expected_category",
      "candidate_artifact",
      "independent_evidence",
      "candidate_writable_paths",
      "source"
    ],
    "types": {
      "schema": "string",
      "bundle_id": "non-empty string",
      "direction": "constant R",
      "case_kind": "object with artifact_level and control_class",
      "failure_family": "one of the six frozen families",
      "expected_category": "ALLOW_WITHIN_SCOPE | BLOCK | REVIEW_REQUIRED",
      "candidate_artifact": "object with path, hash_domain and sha256",
      "independent_evidence": "non-empty array of evidence objects",
      "candidate_writable_paths": "array containing exactly the candidate artifact path",
      "source": "object with origin and case_reference"
    },
    "case_kind_values": {
      "artifact_level": [
        "synthetic_challenge",
        "real_incident",
        "control_exemplar",
        "unverified_inference"
      ],
      "control_class": [
        "BLOCK_SIGNATURE",
        "LEGAL_ALLOW",
        "FAIL_CLOSED",
        "REVIEW_SIGNATURE"
      ]
    },
    "failure_families": [
      "真实调用边界",
      "证据身份",
      "完整性与预算",
      "数据与统计",
      "测量对象",
      "交付与权限"
    ],
    "source_origins": [
      "synthetic_challenge",
      "t1_v3_accepted_case_set"
    ],
    "hash_domains": {
      "sha256_file": "SHA-256 of fixture bytes; only allowed for untracked synthetic fixture artifacts.",
      "git_blob_id": "Canonical git blob id obtained read-only from HEAD:<path>; required for tracked repository evidence."
    },
    "evidence_contract": {
      "required_fields": [
        "evidence_id",
        "path",
        "hash_domain",
        "sha256",
        "assertions",
        "provenance"
      ],
      "assertions": "Non-empty array of frozen assertion signatures from this specification.",
      "provenance": "Trusted case-builder provenance; candidate-controlled evidence is not accepted."
    },
    "candidate_ownership": {
      "candidate_may_write": [
        "the bytes at candidate_artifact.path"
      ],
      "candidate_must_not_write": [
        "case_bundle",
        "expected_category",
        "independent_evidence",
        "evaluator_spec",
        "evaluator implementation",
        "qualification expectations",
        "sealed case material"
      ],
      "content_read_policy": "The evaluator reads candidate artifact bytes only to compute an allowed hash. It never parses candidate scoring code, labels, decisions or self-authored rubrics."
    }
  },
  "assertion_rules": {
    "真实调用边界": {
      "defect": [
        "NON_JSON_NOT_PERSISTED",
        "STRUCTURED_OUTPUT_ENFORCEMENT_MISSING",

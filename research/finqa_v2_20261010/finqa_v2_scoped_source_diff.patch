+            "stages": list(STAGES),
+            "stage_targets": {"train": "40%", "calibration": "20%", "evaluation": "40%"},
+            "deterministic_order": f'SHA256("finqa-v2-split-v1|{SPLIT_DATE}|<stage>|<canonical_group_id>")',
+            "singleton_quota": {"groups": [9, 5, 10], "injections": [81, 45, 90]},

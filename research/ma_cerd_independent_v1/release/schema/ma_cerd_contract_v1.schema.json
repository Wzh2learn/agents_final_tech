{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/killweb/ma_cerd_contract_v1.schema.json",
  "title": "MA-CERD v1 simulator-backed interventional contract",
  "description": "Research benchmark contract only; no operational command authority or deployment claim.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "dataset_id", "contract_id", "base_case_id", "family_id", "scenario_family", "split", "partition", "split_group_id", "base_snapshot", "intervention", "counterfactual_snapshot", "labels", "oracle_bundle", "provenance", "release_status"],
  "properties": {
    "schema_version": {"const": "ma-cerd-contract-v1"},
    "dataset_id": {"const": "MA-CERD"},
    "contract_id": {"type": "string", "minLength": 1},
    "base_case_id": {"type": "string", "minLength": 1},
    "family_id": {"type": "string", "minLength": 1},
    "scenario_family": {"type": "string", "minLength": 1},
    "split": {"enum": ["id", "heldout_intervention", "compositional_ood", "rule_version_ood", "evidence_ood", "graph_topology_ood", "generator_ood"]},
    "partition": {"enum": ["train", "development", "test"]},
    "split_group_id": {"type": "string", "minLength": 1},
    "base_snapshot": {"$ref": "#/$defs/snapshot"},
    "counterfactual_snapshot": {"$ref": "#/$defs/snapshot"},
    "intervention": {"$ref": "#/$defs/intervention"},
    "labels": {"$ref": "#/$defs/labels"},
    "oracle_bundle": {"$ref": "#/$defs/oracleBundle"},
    "provenance": {"$ref": "#/$defs/provenance"},
    "release_status": {"enum": ["draft", "gold", "withdrawn"]}
  },
  "allOf": [
    {
      "if": {"properties": {"release_status": {"const": "draft"}}, "required": ["release_status"]},
      "then": {
        "properties": {
          "oracle_bundle": {
            "properties": {
              "alignment": {"const": "unresolved"},
              "independent_judgment": {
                "required": ["status"],
                "properties": {"status": {"const": "pending"}}
              },
              "simulator_outcome": {
                "required": ["status"],
                "properties": {"status": {"const": "not_run"}}
              }
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"release_status": {"const": "gold"}}, "required": ["release_status"]},
      "then": {
        "properties": {
          "oracle_bundle": {
            "properties": {
              "alignment": {"enum": ["all_agree", "o1_only_disagrees", "o2_only_disagrees", "o3_only_disagrees", "all_different", "o1_o2_conflict", "o1_o3_conflict", "o2_o3_conflict"]},
              "independent_judgment": {
                "required": ["status", "label", "adjudication_record_id", "reviewer_count", "blind_review"],
                "properties": {
                  "status": {"const": "adjudicated"},
                  "label": {"enum": ["change", "invariant", "undetermined"]},
                  "adjudication_record_id": {"type": "string", "minLength": 1},
                  "reviewer_count": {"type": "integer", "minimum": 2},
                  "blind_review": {"const": true}
                }
              },
              "simulator_outcome": {
                "required": ["status", "outcome", "run_id", "trace_ref", "simulator_version", "seed", "execution_mode"],
                "properties": {
                  "status": {"const": "completed"},
                  "outcome": {"enum": ["succeeded", "failed", "inconclusive"]},
                  "run_id": {"type": "string", "minLength": 1},
                  "trace_ref": {"type": "string", "minLength": 1},
                  "simulator_version": {"type": "string", "minLength": 1},
                  "seed": {"type": "integer"},
                  "execution_mode": {"const": "simulator_only_shadow_mode"}
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "snapshot": {
      "type": "object",
      "required": ["requirements", "evidence", "team_state", "joint_plan"],
      "properties": {
        "requirements": {"type": "array"},
        "evidence": {"type": "array"},
        "team_state": {"type": "object"},
        "joint_plan": {
          "type": "object",
          "required": ["joint_plan_id", "decision", "nodes", "edges", "shared_resources"],
          "properties": {
            "joint_plan_id": {"type": "string", "minLength": 1},
            "decision": {"enum": ["execute", "repair", "defer"]},
            "nodes": {"type": "array", "items": {"type": "object", "required": ["node_id"], "properties": {"node_id": {"type": "string", "minLength": 1}}}},
            "edges": {"type": "array"},
            "shared_resources": {"type": "array"}
          }
        }
      }
    },
    "intervention": {
      "type": "object",
      "required": ["intervention_id", "target_kind", "target_id", "field_path", "before", "after", "semantic_change_count", "changed_paths", "mutation_template_id", "generator_version"],
      "properties": {
        "intervention_id": {"type": "string", "minLength": 1},
        "target_kind": {"enum": ["requirement", "authority", "evidence", "state", "expression"]},
        "target_id": {"type": "string", "minLength": 1},
        "field_path": {"type": "string", "minLength": 1},
        "before": {},
        "after": {},
        "semantic_change_count": {"const": 1},
        "changed_paths": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"type": "string", "minLength": 1}},
        "mutation_template_id": {"type": "string", "minLength": 1},
        "generator_version": {"type": "string", "minLength": 1}
      }
    },
    "labels": {
      "type": "object",
      "required": ["relation", "acceptable_decisions", "impact_node_ids", "preserved_node_ids", "rationale_refs"],
      "properties": {
        "relation": {"enum": ["change", "invariant", "undetermined"]},
        "acceptable_decisions": {"type": "array", "minItems": 1, "items": {"enum": ["execute", "repair", "defer"]}},
        "impact_node_ids": {"type": "array", "items": {"type": "string"}},
        "preserved_node_ids": {"type": "array", "items": {"type": "string"}},
        "rationale_refs": {"type": "array", "items": {"type": "string"}}
      }
    },
    "oracleBundle": {
      "type": "object",
      "required": ["rule_oracle", "independent_judgment", "simulator_outcome", "alignment"],
      "properties": {
        "rule_oracle": {"type": "object"},
        "independent_judgment": {"type": "object"},
        "simulator_outcome": {"type": "object"},
        "alignment": {"enum": ["all_agree", "o1_only_disagrees", "o2_only_disagrees", "o3_only_disagrees", "all_different", "o1_o2_conflict", "o1_o3_conflict", "o2_o3_conflict", "unresolved"]}
      }
    },
    "provenance": {
      "type": "object",
      "required": ["source_case_generator", "contract_generator_version", "requirement_library_version", "created_utc", "seed", "source_commit"],
      "properties": {
        "source_case_generator": {"type": "string", "minLength": 1},
        "contract_generator_version": {"type": "string", "minLength": 1},
        "requirement_library_version": {"type": "string", "minLength": 1},
        "created_utc": {"type": "string", "minLength": 1},
        "seed": {"type": "integer"},
        "source_commit": {"type": "string", "minLength": 1}
      }
    }
  }
}

{
  "plan": {
    "type": "object",
    "required": [
      "experience_actions",
      "evidence_candidate_ids"
    ],
    "properties": {
      "experience_actions": {
        "type": "array",
        "maxItems": 0,
        "items": {
          "type": "object",
          "required": [
            "experience_id",
            "decision"
          ],
          "properties": {
            "experience_id": {
              "type": "string"
            },
            "decision": {
              "enum": [
                "APPLY",
                "SKIP",
                "ABSTAIN"
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "evidence_candidate_ids": {
        "type": "array",
        "minItems": 1,
        "maxItems": 8,
        "uniqueItems": true,
        "items": {
          "type": "string"
        }
      }
    },
    "additionalProperties": false
  },
  "evidence_lookup_input": {
    "type": "object",
    "required": [
      "candidate_ids"
    ],
    "properties": {
      "candidate_ids": {
        "type": "array",
        "minItems": 1,
        "maxItems": 8,
        "uniqueItems": true,
        "items": {
          "type": "string"
        }
      }
    },
    "additionalProperties": false
  },
  "evidence_lookup_output": {
    "type": "object",
    "required": [
      "tool_status",
      "evidence"
    ],
    "properties": {
      "tool_status": {
        "enum": [
          "OK",
          "INVALID_ARGUMENT"
        ]
      },
      "error": {
        "type": [
          "string",
          "null"
        ]
      },
      "evidence": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "candidate_id",
            "text",
            "page_number",
            "visible_source_scope"
          ],
          "properties": {
            "candidate_id": {
              "type": "string"
            },
            "text": {
              "type": "string"
            },
            "page_number": {
              "type": [
                "string",
                "null"
              ]
            },
            "visible_source_scope": {
              "type": "object"
            }
          },
          "additionalProperties": false
        }
      }
    },
    "additionalProperties": false
  },
  "consume": {
    "type": "object",
    "required": [
      "answer_status",
      "facts",
      "used_candidate_ids"
    ],
    "properties": {
      "answer_status": {
        "enum": [
          "ANSWER",
          "UNKNOWN",
          "REFUSE"
        ]
      },
      "facts": {
        "type": "array",
        "maxItems": 8,
        "items": {
          "type": "object",
          "required": [
            "label",
            "value",
            "unit",
            "period"
          ],
          "properties": {
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "value": {
              "type": [
                "number",
                "string"
              ]
            },
            "unit": {
              "type": [
                "string",
                "null"
              ]
            },
            "period": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "used_candidate_ids": {
        "type": "array",
        "maxItems": 8,
        "uniqueItems": true,
        "items": {
          "type": "string"
        }
      }
    },
    "additionalProperties": false
  }
}

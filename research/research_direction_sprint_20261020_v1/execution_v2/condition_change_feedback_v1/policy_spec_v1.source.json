                      {"field": "valid", "op": "eq", "value": true}
                    ]
                  }
                ]
              ],
              "id": "manager_approval",
              "when": {"field": "amount_usd", "op": "gt", "value": 100}
            }
          ]
        }
      ],
      "policy_version_id": "expense_policy_pre_v1"
    },
